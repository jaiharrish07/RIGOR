# ==============================================================================
# RIGOR Environment Variables
#
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ==============================================================================

# --- Database ---
# POSTGRES_* provision the container (docker-compose.yml reads them).
# DATABASE_URL is what the app connects with. The password must match across
# both, or the app will authenticate against a container it just created.
POSTGRES_USER=rigor
POSTGRES_PASSWORD=rigor
POSTGRES_DB=rigor

DATABASE_URL=postgresql+psycopg://rigor:rigor@localhost:5433/rigor

# Used only by pytest. The database is created on first `docker compose up` by
# scripts/init_test_db.sql; the test suite creates the tables inside it.
TEST_DATABASE_URL=postgresql+psycopg://rigor:rigor@localhost:5433/rigor_test

# --- GROBID ---
GROBID_URL=http://localhost:8070

# --- LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- App settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20

# --- LLM (OpenRouter fallback) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free